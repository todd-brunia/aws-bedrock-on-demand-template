aws_account_id              = "123456789012"
state_bucket_name           = "replace-with-unique-non-identifying-state-bucket"
github_oidc_subject_prefix  = "repo:YOUR_ORGANIZATION/YOUR_REPOSITORY"
# Obtain the exact prefix with:
# gh api repos/YOUR_ORGANIZATION/YOUR_REPOSITORY/actions/oidc/customization/sub --jq .sub_claim_prefix
# Set github_oidc_provider_arn when the account already has one; do not create a duplicate.
